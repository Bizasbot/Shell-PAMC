# Shell-PAMC local development environment (never commit: already in .gitignore)
# Loaded by cmd/shell-pamc before config.Load(); real environment variables win.
# The companion CLIProxyAPI lives in ./cpa (also uncommitted); `pnpm cpa:start` starts it.

# --- Shell-PAMC service ---
# Vite follows this address while proxying /shell-pamc/api, so a taken port only needs a
# change here (SHELLPAMC_API_TARGET overrides the proxy target if the API is remote).
SHELLPAMC_LISTEN_ADDR=127.0.0.1:8080
SHELLPAMC_BASE_PATH=/shell-pamc
SHELLPAMC_DATA_DIR=tmp/oh-my-cpa-data
SHELLPAMC_VERSION=v0.1.0-dev

# The login password IS the CPA management key below (same credential as CPA's own panel).
# Use a 64-hex-character master key, e.g. `openssl rand -hex 32`.
SHELLPAMC_MASTER_KEY=your-64-hex-character-master-key

# --- Local CLIProxyAPI (./cpa/config.yaml, or a container on this machine) ---
# host: 127.0.0.1, port: 8317, matching remote-management.secret-key in plaintext.
# A containerized CPA works the same way: use the loopback port it publishes.
SHELLPAMC_CPA_BASE_URL=http://127.0.0.1:8317
# The plaintext secret-key itself, never the bcrypt hash stored in CPA's config.yaml.
SHELLPAMC_CPA_MANAGEMENT_KEY=your-cpa-management-key
SHELLPAMC_CPA_USAGE_ADDR=127.0.0.1:8317
SHELLPAMC_REQUEST_TIMEOUT=15s
SHELLPAMC_CPA_TLS_SKIP_VERIFY=false

# --- Background usage collection (keeps running with no browser open) ---
SHELLPAMC_USAGE_INGEST_MODE=auto
SHELLPAMC_USAGE_IDLE_INTERVAL=1s
# Max idle wait plus request time must stay well below CPA's redis-usage-queue-retention-seconds.
SHELLPAMC_USAGE_MAX_IDLE_INTERVAL=10s
SHELLPAMC_USAGE_BATCH_SIZE=1000

# --- Login throttling behind a reverse proxy (unset for local development) ---
# Comma-separated CIDRs of reverse proxies whose X-Forwarded-For may be trusted for
# per-client throttling. Clients reach this machine directly during development, so
# this stays unset and the direct peer address is used. Image-based Compose deployments
# likewise leave it empty; only trust the actual peers of an operator-owned proxy.
# SHELLPAMC_TRUSTED_PROXY_CIDRS=172.16.0.0/12

# --- Public demonstration (off by default) ---
# Runs the console from an in-process fixture instead of a CPA: no management key, no
# provider credential, and a server that refuses sign-in, credential movement, plugin
# execution and gateway configuration writes. Its database is deleted and rebuilt on
# every boot, so nothing it stores is durable. See docs/architecture.md §12.
SHELLPAMC_DEMO_MODE=false

# IANA deployment timezone shared by OMC and CPA in Compose.
TZ=UTC
