# Copy to .env in the working directory; real environment variables take precedence.
# Bind locally by default. Put remote access behind an operator-owned HTTPS ingress.
SHELLPAMC_LISTEN_ADDR=127.0.0.1:8080
SHELLPAMC_BASE_PATH=/omc
SHELLPAMC_DATA_DIR=./data
# Generate once: openssl rand -hex 32. Preserve this key across upgrades and backups.
SHELLPAMC_MASTER_KEY=replace-me
SHELLPAMC_CPA_BASE_URL=http://127.0.0.1:8317
# CPA's plaintext management key is also the console sign-in password.
SHELLPAMC_CPA_MANAGEMENT_KEY=replace-with-your-cpa-management-key
# Match CPA's deployment time zone. The executable embeds the IANA database.
TZ=UTC
# Only one tool may consume CPA's usage queue. Use off if another reader keeps it.
SHELLPAMC_USAGE_INGEST_MODE=auto
