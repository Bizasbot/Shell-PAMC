{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "shell-pamc-demo",
  "main": "worker.mjs",
  // No se declara ninguna ruta: añada `"routes": [{ "pattern": "<su dominio>", "custom_domain": true }]` antes de desplegar. La ruta `workers.dev` está desactivada
  // porque ese subdominio es a nivel de cuenta y se deriva de la identidad de la cuenta del operador,
  // por lo que dejarlo activo publicaría la demostración en una dirección que contiene información
  // personal. Indicar ambos aquí en lugar de configurarlos manualmente en la consola garantiza que un despliegue
  // desde una copia limpia reproduzca el estado previsto en vez de reactivar silenciosamente la dirección deshabilitada.
  "workers_dev": false,
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "../../tmp/cloudflare-demo/assets",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "observability": {
    "enabled": true
  }
}
